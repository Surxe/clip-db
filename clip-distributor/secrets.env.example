# clip-db / clip-distributor secrets -- EXAMPLE ONLY (safe to commit; no values).
#
# The real file is NOT in this repo and NOT anywhere `dev` can read it. `dev` is the
# repo-writable, AI-touched account, so this secret lives in ethan's space, mode 600,
# mirroring ~ethan/.config/steam-price-tracker/smtp.env:
#
#   ~ethan/.config/clip-db/secrets.env   (chmod 600, ethan-owned)
#
# Create it once (as ethan):
#   install -d -m 700 ~/.config/clip-db
#   cp /srv/dev/repos/clip-db/clip-distributor/secrets.env.example \
#      ~/.config/clip-db/secrets.env
#   chmod 600 ~/.config/clip-db/secrets.env
#   # then paste the webhook URL below, by hand
#
# post.py runs as `dev` and CANNOT read this file. The ethan-owned `clip-post` launcher
# sources it and injects the value into the dev run's ENVIRONMENT:
#   set -a; . ~/.config/clip-db/secrets.env; set +a
#   sudo -u dev --preserve-env=CLIP_DISCORD_WEBHOOK \
#     /srv/dev/repos/clip-db/.venv/bin/python clip-distributor/post.py ...
# so dev only ever sees it transiently in a running process, never at rest. It is never
# placed on a command line (no `ps` exposure).

# Discord channel webhook URL (Server Settings -> Integrations -> Webhooks -> Copy URL).
# Anyone with this URL can post to that channel -- treat it as a password. If it leaks,
# delete + recreate the webhook in Discord; that is the entire blast radius.
CLIP_DISCORD_WEBHOOK=""
