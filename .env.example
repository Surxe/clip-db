# Paths (Linux). Relative paths resolve against the repo root.
# CLIP_SOURCE_DIR is the read-only save location clips are recorded into (the NTFS share,
# shared with Windows). The pipeline never writes or deletes there. mirror.py mirrors new
# masters from it into the writable ext4 intake dir; describe.py/ingest.py run mirror.py
# automatically, so clips flow source -> intake -> library with no manual copy step.
# Leave CLIP_SOURCE_DIR unset to disable the mirror and treat intake as authoritative.
CLIP_SOURCE_DIR=/mnt/os-shared/transfer/clips
CLIP_INTAKE_DIR=/srv/dev/clips/intake
CLIP_LIBRARY_DIR=/srv/dev/clips/library
CLIP_INDEX_PATH=/srv/dev/clips/index.sqlite
# Spool the MCP's queue_discord_post tool drops jobs into, for the ethan-side watcher
# to upload via clip-post (dev can't read the webhook secret, so it hands off here).
# Needs to be group-writable (setgid, group developers) so both users can drop/move.
CLIP_DISCORD_QUEUE_DIR=/srv/dev/clips/discord-queue
CLIP_TAGS_PATH=tags.json
# Tag relations applied at classify time (see docs/tags.md). Both optional -- a
# missing file just disables that mechanism. Relative paths resolve against the repo root.
CLIP_ALIASES_PATH=tag_aliases.json           # nickname -> canonical tag (snaketrap -> snake catcher)
CLIP_IMPLICATIONS_PATH=tag_implications.json  # torso ability -> module it also assigns (snake catcher -> garuda)
# Per-clip descriptions manifest (stem -> sentence), written by describe.py, read by ingest.py.
# Defaults to descriptions.json inside CLIP_INTAKE_DIR; uncomment to relocate.
# CLIP_DESCRIPTIONS_PATH=/srv/dev/clips/intake/descriptions.json
CLIP_MODEL=claude-sonnet-4-5

# Semantic search (RAG retrieval). Clips are embedded (description + tags) with a local,
# frozen sentence-transformers model into a sqlite-vec index beside the clip index; a
# natural-language query is embedded the same way and matched by cosine top-k. No API key
# or per-call cost -- the model runs on the dev box. CLIP_EMBED_MODEL is PINNED: changing it
# invalidates every stored vector (re-run `scripts/embed_backfill.py --all`). CLIP_SEMANTIC_TOP_K
# is the default number of clips the MCP `semantic_search` tool returns.
CLIP_EMBED_MODEL=all-MiniLM-L6-v2
CLIP_SEMANTIC_TOP_K=5

# Max master duration (seconds) that `merge.py --auto` will mix down to a _merged.mp4.
CLIP_AUTO_MERGE_MAX_SECONDS=120

# clip-distributor: where share.py / post.py write the compressed, cap-fitting copy
# (named <stem>_merged_<cap>mb.mp4). Defaults to the library dir, so the rendition sits
# beside its master; set this to divert it elsewhere.
# CLIP_SHARE_DIR=/home/you/clip-share

# clip-distributor/post.py uploads a clip to a Discord channel webhook. The URL is a
# SECRET and does NOT belong in this repo .env -- it lives in ethan's space
# (~ethan/.config/clip-db/secrets.env, chmod 600) and is injected at launch by the
# ethan-owned `clip-post` launcher. See clip-distributor/secrets.env.example.
#   CLIP_DISCORD_WEBHOOK=...   (set in the secrets file, not here)

# Classification runs through the `claude` CLI (Claude Code, print mode), so it bills
# against your logged-in Claude subscription -- no Anthropic API key needed. Requirements:
# `claude` on PATH and authenticated (run `claude` once to log in). CLIP_MODEL accepts any
# id/alias `claude --model` takes (e.g. claude-sonnet-4-5, sonnet, claude-opus-4-8).
