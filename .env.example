# Paths (Linux). Clips stage in os-shared (NTFS, shared with Windows), then move
# into the ext4 library on ingest. Relative paths resolve against the repo root.
CLIP_INTAKE_DIR=/mnt/os-shared/transfer/clips
CLIP_LIBRARY_DIR=/srv/dev/clips/library
CLIP_INDEX_PATH=/srv/dev/clips/index.sqlite
CLIP_TAGS_PATH=tags.json
CLIP_MODEL=claude-opus-5

# ANTHROPIC_API_KEY is resolved from the environment or an `ant auth login` profile.
# Uncomment to pin an explicit key instead:
# ANTHROPIC_API_KEY=sk-ant-...
